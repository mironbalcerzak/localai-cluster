# Copy to .env (or get a filled-in .env from the server: `localai worker-kit`).

# --- set this on each PC ---
# Wi-Fi IP of THIS worker PC (Windows: ipconfig, Linux: hostname -I)
WORKER_IP=
# Name shown in the server's Nodes page (default: worker-<ip>)
WORKER_NAME=

# --- from the server ---
LOCALAI_SERVER=
LOCALAI_SERVER_PORT=23422
LOCALAI_REGISTRATION_TOKEN=

# Parallel requests this GPU serves at once
LLAMACPP_PARALLEL=5
