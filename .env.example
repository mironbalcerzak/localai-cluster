# LocalAI cluster settings. The host creates .env from scratch on its first run
# (`localai-cluster.sh host` / `localai-cluster.bat host`); this file only documents the format.
# Workers use a copy of the host's .env, placed next to localai-cluster.sh / localai-cluster.bat.

# Address of the host. Update it here and on the workers if the host's IP changes.
LOCALAI_SERVER=192.168.1.10
LOCALAI_PORT=23422
LOCALAI_REGISTRATION_TOKEN=
# Key for API clients, sent as a Bearer token.
LOCALAI_API_KEY=
# Web UI login, created as admin on the host's first start. Must be an email address.
LOCALAI_ADMIN_EMAIL=admin@localai
LOCALAI_ADMIN_PASSWORD=admin123456

# Model loaded on every PC. Parallel requests per PC are picked by LocalAI from the
# GPU's VRAM; LLAMACPP_PARALLEL is used only when it picks none.
LOCALAI_MODEL=gemma-4-12B-it-qat-UD-Q4_K_XL
LOCALAI_EMBEDDING_MODEL=Qwen3-Embedding-8B-Q4_K_M.gguf
# Models load on the first request and unload after this long without one.
LOCALAI_IDLE_UNLOAD=2m
LLAMACPP_PARALLEL=5

# Used by the host only.
LOCALAI_BIND=0.0.0.0
POSTGRES_PASSWORD=

# Worker only, normally detected: IP and name of the worker PC.
WORKER_IP=
WORKER_NAME=
