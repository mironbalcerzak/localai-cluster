# LocalAI cluster settings. The host creates .env from scratch on its first run
# (`localai.sh host` / `localai.bat host`); this file only documents the format.
# Workers use a copy of the host's .env, placed next to localai.sh / localai.bat.

# Address of the host. Update it here and on the workers if the host's IP changes.
LOCALAI_SERVER=192.168.1.10
LOCALAI_PORT=23422
LOCALAI_REGISTRATION_TOKEN=
# Key for API clients, sent as a Bearer token.
LOCALAI_API_KEY=

# Model loaded on every PC, and parallel requests per PC.
LOCALAI_MODEL=gemma-4-12b-it-Q4_K_M
LLAMACPP_PARALLEL=5

# Used by the host only.
LOCALAI_BIND=0.0.0.0
POSTGRES_PASSWORD=

# Worker only, normally detected: IP and name of the worker PC.
WORKER_IP=
WORKER_NAME=
