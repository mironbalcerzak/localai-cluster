# Worker settings. The configured file goes to docker/worker/.env
# (on the host, `localai-host.sh worker-env` / `localai-host.bat worker-env` creates it).

# --- LocalAI server ---
LOCALAI_SERVER=
LOCALAI_SERVER_PORT=23422
LOCALAI_REGISTRATION_TOKEN=
# Optional: lets the start scripts send a test request after starting.
LOCALAI_API_KEY=

# Model the start scripts test with. Which models the workers load is
# decided on the host (docker/host/scheduling.yaml).
LOCALAI_MODEL=gemma-4-12b-it-Q4_K_M

# Parallel requests this GPU serves at once
LLAMACPP_PARALLEL=5

# --- this PC: leave empty for auto-detection ---
# Wi-Fi IP of this PC (the server connects back to it)
WORKER_IP=
# Name shown in the server's Nodes page (default: computer name)
WORKER_NAME=
